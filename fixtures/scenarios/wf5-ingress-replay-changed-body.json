  "expect": {
    "decision": "IDEMPOTENCY_CONFLICT",
    "basis": "IDEMPOTENCY_CONFLICT",
    "matter_id": "MAT-QA-001",
    "communication_id": "COM-MSG-RT-1",
    "requires_human_review": true,
    "event_id": "EVT-REPLAY-CONFLICT-MSG-RT-1",
    "event_type": "INBOUND_REPLAY_IGNORED_CONFLICT",
    "severity": "WARNING",
    "reason_shape": "Already recorded but the raw message differs (stored <storedFp>, now <newFp>).",
    "needs_hash_regen": true,
    "ingress_fingerprint_spec": "ingressFingerprint(e) = 'ING-' + fnv1a32(parts) + '-' + canon(e.body).length, where parts = ['pmid=' + trim(pmid), 'thread=' + trim(thread_id), 'from=' + emailOf(from), 'subject=' + canon(subject), 'body=' + canon(body), 'ts=' + trim(received_at)].join(' '); canon collapses all whitespace runs to a single space and trims; emailOf extracts the address inside angle brackets and lowercases it; fnv1a32 is a single 32-bit FNV-1a pass (offset basis 0x811c9dc5) rendered as 8 lowercase hex characters.",
    "note": "Both fingerprints must be recomputed. The two must differ: the bodies differ in both content and canonicalised length (20 vs 47)."
  },
  "assertions": [
    "A stored fingerprint that differs from the recomputed one yields IDEMPOTENCY_CONFLICT, never ACCEPT and never ALREADY_RECORDED.",
    "requires_human_review is true and severity is WARNING.",
    "The conflict reason names both the stored and the incoming fingerprint so a human can see which is which.",
    "communication_id is still the stored deterministic value, so the conflict event points at the row it is about.",
    "No Communications, Actions or Matters mutation is proposed."
  ],
  "target": {
    "workflow": "wf5",
    "unit_file": "harness/units/wf5/build-reply-context.js"
  },
  "harness": {
    "adapter": "reply-policy"
  }
}
