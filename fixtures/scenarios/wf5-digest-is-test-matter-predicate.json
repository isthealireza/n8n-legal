  "expect": {
    "results": [
      true,
      true,
      true,
      true,
      true,
      true,
      true,
      true,
      true,
      true,
      false,
      false,
      false
    ],
    "rules": {
      "id": "/^MAT-TEST\\b|^MAT-QA\\b|^MAT-SANDBOX\\b/ on the trimmed upper-cased matter_id",
      "title": "/\\bTEST[ _-]ONLY\\b|\\bDO NOT USE\\b/ on the trimmed upper-cased title",
      "facts": "any of test_data_only, matter_flagged_test_only, is_test whose trimmed upper-cased value is exactly 'TRUE'",
      "risks": "any risk flag matching /TEST[_ ]ONLY|SYNTHETIC|DO[_ ]NOT[_ ]USE/i",
      "parse_failure": "a facts_json or risk_flags_json that does not parse is treated as empty, never as a match",
      "null_input": "returns false"
    }
  },
  "assertions": [
    "Each of the four independent signals - id prefix, title wording, recorded fact flag, risk flag - is sufficient on its own.",
    "Matching is case-insensitive and whitespace-tolerant on the title and the fact flag values.",
    "Malformed facts_json or risk_flags_json must not throw and must not be treated as a match.",
    "A null or undefined matter returns false rather than throwing.",
    "A live matter with an ordinary title, ordinary facts and a real risk flag is NOT classified as a test matter.",
    "This predicate must stay byte-identical to the copy in WF5 Build Daily Digest; a drift means the digest and the QA harness disagree about what counts as live work."
  ],
  "target": {
    "workflow": "wf5",
    "unit_file": "harness/units/wf5/build-daily-digest.js"
  },
  "harness": {
    "adapter": "digest-testmatter"
  }
