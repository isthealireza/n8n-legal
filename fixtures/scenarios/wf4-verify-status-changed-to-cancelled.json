{
  "workflow": "wf4",
  "unit": "WF4 Integrity Guard and Verify Selected Row fail-closed gates",
  "kind": "pure",
  "source_qa_workflow": {
    "id": "hTz7VbLHENx8ZB1N",
    "name": "QA - WF4 Integrity Guard Runtime"
