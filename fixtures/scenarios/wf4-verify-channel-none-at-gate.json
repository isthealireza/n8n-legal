  "id": "wf4-verify-channel-none-at-gate",
  "description": "If the Approval Gate emits channel='NONE' (its sentinel for 'could not resolve'), the branch halts with CHANNEL_UNRESOLVED before any send.",
  "why_it_exists": "D-CHANNEL-01 (2026-08-25). The old guard condition was `U(gate.channel) !== U(row.channel) && U(gate.channel) !== 'NONE'`. When the gate could not resolve a channel it emitted 'NONE'; the second term fired (NONE === NONE), the halt was skipped, and the branch continued to the Gmail nodes with integrity_ok: true. FINDINGS.md §3 proved this with a real probe. This scenario covers the NONE path that the old test suite marked as a KNOWN GAP.",
  "input": {
    "case_id": "C5D",
    "config": {
      "matter_id": "MAT-QA-CLEAN",
      "route_group": "APPROVAL",
      "approval_id": "APR-QACLEAN"
    },
    "actions": [
      {
        "action_id": "ACT-QA-CLEAN-001",
        "matter_id": "MAT-QA-CLEAN",
        "action_type": "CONTACT_INSURER",
        "status": "AWAITING_APPROVAL",
        "priority": "HIGH",
        "depends_on_json": "[]",
        "recipient": "claims@insurer.example",
        "channel": "GMAIL",
        "requires_approval": "TRUE",
        "draft_id": "DRF-QA-CLEAN-001-v1",
        "approval_id": "APR-QACLEAN",
        "due_at": "",
        "deadline_basis": "",
        "blocked_reason": "",
        "idempotency_key": "MAT-QA-CLEAN|PQA|001",
        "created_at": "2026-08-21T00:00:00Z",
        "updated_at": "2026-08-21T00:00:00Z"
      }
    ],
    "approvals": [
      {
        "approval_id": "APR-QACLEAN",
        "matter_id": "MAT-QA-CLEAN",
        "action_id": "ACT-QA-CLEAN-001",
        "draft_id": "DRF-QA-CLEAN-001-v1",
        "status": "PENDING"
      }
    ],
    "injected_fault": {
      "where": "between Approval Gate and Verify Selected Row",
      "channel": "NONE"
    },
    "register_row_channel": "GMAIL",
    "now": "2026-08-23T06:00:00.000Z",
    "nodeOutputs": {
      "Config": [
        {
          "matter_id": "MAT-QA-CLEAN",
          "route_group": "APPROVAL",
          "approval_id": "APR-QACLEAN"
        }
      ],
      "Load Actions": [
        {
          "action_id": "ACT-QA-CLEAN-001",
          "matter_id": "MAT-QA-CLEAN",
          "action_type": "CONTACT_INSURER",
          "status": "AWAITING_APPROVAL",
          "priority": "HIGH",
          "depends_on_json": "[]",
          "recipient": "claims@insurer.example",
          "channel": "GMAIL",
          "requires_approval": "TRUE",
          "draft_id": "DRF-QA-CLEAN-001-v1",
          "approval_id": "APR-QACLEAN",
          "due_at": "",
          "deadline_basis": "",
          "blocked_reason": "",
          "idempotency_key": "MAT-QA-CLEAN|PQA|001",
          "created_at": "2026-08-21T00:00:00Z",
          "updated_at": "2026-08-21T00:00:00Z"
        }
      ],
      "Load Approvals": [
        {
          "approval_id": "APR-QACLEAN",
          "matter_id": "MAT-QA-CLEAN",
          "action_id": "ACT-QA-CLEAN-001",
          "draft_id": "DRF-QA-CLEAN-001-v1",
          "status": "PENDING"
        }
      ]
    }
  },
  "expect": {
    "verify_integrity_ok": false,
    "integrity_code": "CHANNEL_UNRESOLVED",
    "reaches": "Halt - Data Integrity Conflict"
  },
  "assertions": [
    "integrity_code is CHANNEL_UNRESOLVED — not CHANNEL_MISMATCH",
    "integrity_detail carries both the gate channel ('NONE') and the row channel",
    "the old single-condition guard would have passed this (integrity_ok: true); the new two-guard fix must halt it",
    "no Gmail node is reachable past this point"
  ],
  "target": {
    "workflow": "wf4",
    "unit_file": "harness/units/wf4/verify-selected-row.js"
  },
  "harness": {
    "adapter": "verify-selected-row"
